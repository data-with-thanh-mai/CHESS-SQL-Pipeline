DATA_MODE="dev"
DATA_PATH="./data/dev/dev.json"
DB_ROOT_PATH="./data"
DB_ROOT_DIRECTORY="./data/dev/dev_databases"
INDEX_SERVER_HOST='localhost'
INDEX_SERVER_PORT=12345

# -------------------------------------------------------------
# DeepSeek API (For Candidate Generation)
# Get key from https://platform.deepseek.com or use OpenRouter
# -------------------------------------------------------------
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_API_BASE="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-coder"

# -------------------------------------------------------------
# Llama-3-70B API (For Information Retriever, Schema Selector, Unit Tester)
# Options:
# 1. Groq (Fast & Free Tier): https://console.groq.com
#    LLAMA_API_KEY="gsk_..."
#    LLAMA_API_BASE="https://api.groq.com/openai/v1"
#    LLAMA_MODEL="llama-3.3-70b-versatile"
#
# 2. OpenRouter: https://openrouter.ai
#    LLAMA_API_KEY="sk-or-..."
#    LLAMA_API_BASE="https://openrouter.ai/api/v1"
#    LLAMA_MODEL="meta-llama/llama-3.3-70b-instruct"
# -------------------------------------------------------------
LLAMA_API_KEY="gsk_..."
LLAMA_API_BASE="https://api.groq.com/openai/v1"
LLAMA_MODEL="llama-3.3-70b-versatile"

# Optional: If you use OpenRouter for both, just provide OPENROUTER_API_KEY
OPENROUTER_API_KEY=""
